   "source": [
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.metrics import accuracy_score\n",
    "from sklearn import tree"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 24,
   "id": "9af2d5d6-5b1b-45cc-a649-d4fccfe7632c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset:\n",
      "    Outlook Temperature Humidity    Wind Answer\n",
      "0     sunny         hot     high    weak     no\n",
      "1     sunny         hot     high  strong     no\n",
      "2  overcast         hot     high    weak    yes\n",
      "3      rain        mild     high    weak    yes\n",
      "4      rain        cool   normal    weak    yes\n"
     ]
    }
   ],
   "source": [
    "# --------------------------------------------------\n",
    "# 1. Load CSV Dataset\n",
    "# --------------------------------------------------\n",
    "\n",
    "data = pd.read_csv(\"id3.csv\")\n",
    "\n",
    "print(\"Dataset:\")\n",
    "print(data.head())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "432abf60-48d6-4f9c-9591-f63cf32ced97",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Convert text data into numbers\n",
    "encoder = LabelEncoder()\n",
    "\n",
    "data['Outlook'] = encoder.fit_transform(data['Outlook'])\n",
    "data['Temperature'] = encoder.fit_transform(data['Temperature'])\n",
    "data['Humidity'] = encoder.fit_transform(data['Humidity'])\n",
    "data['Wind'] = encoder.fit_transform(data['Wind'])\n",
    "data['Answer'] = encoder.fit_transform(data['Answer'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "24ca5737-eb52-4793-84f9-99ad95ad8177",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# Separate input and output\n",
    "X = data.drop('Answer', axis=1)\n",
    "Y = data['Answer']\n",
    "\n",
    "\n",
    "# Split data\n",
    "X_train, X_test, Y_train, Y_test = train_test_split(\n",
    "    X, Y, test_size=0.2, random_state=42\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 27,
   "id": "98d02ba4-6d1d-4904-adb1-e0288ab6eb73",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Actual Values:\n",
      "[1 1 0]\n",
      "\n",
      "Predicted Values:\n",
      "[1 1 0]\n"
     ]
    }
   ],
   "source": [
    "# Create ID3 Decision Tree\n",
    "model = DecisionTreeClassifier(\n",
    "    criterion='entropy',\n",
    "    random_state=42\n",
    ")\n",
    "\n",
    "\n",
    "# Train model\n",
    "model.fit(X_train, Y_train)\n",
    "\n",
    "\n",
    "# Prediction\n",
    "Y_pred = model.predict(X_test)\n",
    "\n",
    "print(\"\\nActual Values:\")\n",
    "print(Y_test.values)\n",
    "\n",
    "print(\"\\nPredicted Values:\")\n",
    "print(Y_pred)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "2b73b196-30e6-4d9b-a501-7aeb982e4d6e",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Accuracy:\n",
      "1.0\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1200x700 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "# Accuracy\n",
    "print(\"\\nAccuracy:\")\n",
    "print(accuracy_score(Y_test, Y_pred))\n",
    "\n",
    "\n",
    "# Plot Decision Tree\n",
    "plt.figure(figsize=(12, 7))\n",
    "\n",
    "tree.plot_tree(\n",
    "    model,\n",
    "    feature_names=X.columns,\n",
    "    class_names=['No', 'Yes'],\n",
    "    filled=True\n",
    ")\n",
    "\n",
    "plt.title(\"ID3 Decision Tree\")\n",
    "plt.show()"
   ]
  },
