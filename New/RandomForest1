   "source": [
    "import pandas as pd\n",
    "from sklearn.preprocessing import LabelEncoder\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import accuracy_score"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "b4b95f21-f67f-4237-b495-6df407ab144d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Dataset:\n",
      "     Outlook Temperature Humidity    Wind Answer\n",
      "0      sunny         hot     high    weak     no\n",
      "1      sunny         hot     high  strong     no\n",
      "2   overcast         hot     high    weak    yes\n",
      "3       rain        mild     high    weak    yes\n",
      "4       rain        cool   normal    weak    yes\n",
      "5       rain        cool   normal  strong     no\n",
      "6   overcast        cool   normal  strong    yes\n",
      "7      sunny        mild     high    weak     no\n",
      "8      sunny        cool   normal    weak    yes\n",
      "9       rain        mild   normal    weak    yes\n",
      "10     sunny        mild   normal  strong    yes\n",
      "11  overcast        mild     high  strong    yes\n",
      "12  overcast         hot   normal    weak    yes\n",
      "13      rain        mild     high  strong     no\n"
     ]
    }
   ],
   "source": [
    "# Load CSV file\n",
    "data = pd.read_csv(\"id3.csv\")\n",
    "\n",
    "print(\"Dataset:\")\n",
    "print(data)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "e33dd453-1597-40f6-ac9e-88959befa073",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "# Convert text data into numbers\n",
    "encoder = LabelEncoder()\n",
    "\n",
    "data['Outlook'] = encoder.fit_transform(data['Outlook'])\n",
    "data['Temperature'] = encoder.fit_transform(data['Temperature'])\n",
    "data['Humidity'] = encoder.fit_transform(data['Humidity'])\n",
    "data['Wind'] = encoder.fit_transform(data['Wind'])\n",
    "data['Answer'] = encoder.fit_transform(data['Answer'])\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "1bdb9758-bc92-41df-95df-f29bad260016",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Separate input and output\n",
    "X = data.drop('Answer', axis=1)\n",
    "Y = data['Answer']\n",
    "\n",
    "\n",
    "# Split dataset\n",
    "X_train, X_test, Y_train, Y_test = train_test_split(\n",
    "    X, Y, test_size=0.2, random_state=42\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "40b8ef97-ca4c-45cf-ada4-8fca3ae1ab89",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "Number of Trees: 5\n",
      "Accuracy: 0.6666666666666666\n",
      "\n",
      "Number of Trees: 10\n",
      "Accuracy: 0.6666666666666666\n",
      "\n",
      "Number of Trees: 20\n",
      "Accuracy: 0.6666666666666666\n",
      "\n",
      "Number of Trees: 50\n",
      "Accuracy: 1.0\n",
      "\n",
      "Number of Trees: 100\n",
      "Accuracy: 0.6666666666666666\n"
     ]
    }
   ],
   "source": [
    "# 5. Different number of trees\n",
    "numbers = [5, 10, 20, 50, 100]\n",
    "\n",
    "accuracy_list = []\n",
    "\n",
    "\n",
    "# 6. Apply Random Forest\n",
    "for n in numbers:\n",
    "\n",
    "    model = RandomForestClassifier(\n",
    "        n_estimators=n,\n",
    "        random_state=42\n",
    "    )\n",
    "\n",
    "    # Train model\n",
    "    model.fit(X_train, Y_train)\n",
    "\n",
    "    # Prediction\n",
    "    prediction = model.predict(X_test)\n",
    "\n",
    "    # Accuracy\n",
    "    accuracy = accuracy_score(Y_test, prediction)\n",
    "\n",
    "    accuracy_list.append(accuracy)\n",
    "\n",
    "    print(\"\\nNumber of Trees:\", n)\n",
    "    print(\"Accuracy:\", accuracy)"
   ]
  },
