    "# Experiment: Regression for Continuous and Discrete Data\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "\n",
    "\n",
    "# ---------------------------------------------------\n",
    "# 1. Regression for Continuous Data\n",
    "# ---------------------------------------------------\n",
    "\n",
    "# Continuous data\n",
    "X = np.array([1, 2, 3, 4, 5, 6, 7, 8]).reshape(-1, 1)\n",
    "Y = np.array([2.5, 4.1, 6.2, 8.0, 10.3, 12.1, 14.2, 16.1])\n",
    "\n",
    "# Create Linear Regression model\n",
    "model = LinearRegression()\n",
    "\n",
    "# Train the model\n",
    "model.fit(X, Y)\n",
    "\n",
    "# Predict values\n",
    "Y_pred = model.predict(X)\n",
    "\n",
    "print(\"Continuous Data\")\n",
    "print(\"Predicted Values:\")\n",
    "print(Y_pred)\n",
    "\n",
    "print(\"Slope:\", model.coef_[0])\n",
    "print(\"Intercept:\", model.intercept_)\n",
    "\n",
    "\n",
    "# Plot Continuous Regression\n",
    "plt.scatter(X, Y, label=\"Actual Data\")\n",
    "plt.plot(X, Y_pred, label=\"Regression Line\")\n",
    "\n",
    "plt.xlabel(\"X\")\n",
    "plt.ylabel(\"Y\")\n",
    "plt.title(\"Linear Regression - Continuous Data\")\n",
    "plt.legend()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "# ---------------------------------------------------\n",
    "# 2. Regression for Discrete Data\n",
    "# ---------------------------------------------------\n",
    "\n",
    "# Discrete data\n",
    "X2 = np.array([1, 2, 3, 4, 5, 6]).reshape(-1, 1)\n",
    "Y2 = np.array([2, 5, 10, 17, 26, 37])\n",
    "\n",
    "# Create polynomial features\n",
    "poly = PolynomialFeatures(degree=2)\n",
    "\n",
    "X2_poly = poly.fit_transform(X2)\n",
    "\n",
    "# Create regression model\n",
    "model2 = LinearRegression()\n",
    "\n",
    "# Train model\n",
    "model2.fit(X2_poly, Y2)\n",
    "\n",
    "# Predict values\n",
    "Y2_pred = model2.predict(X2_poly)\n",
    "\n",
    "print(\"\\nDiscrete Data\")\n",
    "print(\"Predicted Values:\")\n",
    "print(Y2_pred)\n",
    "\n",
    "\n",
    "# Plot Discrete Regression\n",
    "plt.scatter(X2, Y2, label=\"Actual Data\")\n",
    "plt.plot(X2, Y2_pred, label=\"Regression Curve\")\n",
    "\n",
    "plt.xlabel(\"X\")\n",
    "plt.ylabel(\"Y\")\n",
    "plt.title(\"Polynomial Regression - Discrete Data\")\n",
    "plt.legend()\n",
    "plt.show()"
   ]
